#!/bin/sh
# Pre-commit hook: verify all docs/ code references are valid.
# Install: git config core.hooksPath .githooks

echo "🔍 Checking doc code references..."
python3 scripts/verify_doc_paths.py
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "❌ Stale code references found in docs/. Update paths or run:"
    echo "   python3 scripts/verify_doc_paths.py"
    exit 1
fi

echo "✅ All doc references valid."
exit 0
